{
  // Cloudflare Workers configuration for the qwemu static site.
  // Deploy with: npx wrangler deploy
  "name": "qwemu",
  "compatibility_date": "2026-11-01",

  // Static assets are served straight from ./web (no Worker script needed).
  "assets": {
    "directory": "./web",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
