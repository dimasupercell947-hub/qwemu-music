{
  "name": "qwemu",
  "compatibility_date": "2026-11-01",
  "main": "./public/_worker.js/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qwemu-web",
      "database_id": "ВСТАВЬТЕ_UUID_ИЗ_wrangler_d1_list"
    }
  ],
  "observability": {
    "enabled": true
  }
}
